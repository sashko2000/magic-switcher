<Project Sdk="Microsoft.NET.Sdk">

  <!-- Experiment: can the link key of a paired Bluetooth keyboard be tested without touching the pairing?
       An RFCOMM connection that requires authentication makes Windows authenticate the link with the stored key
       before anything else. The keyboard has no RFCOMM service, so the connection fails either way — the question
       is whether it fails differently for a keyboard that still has our key and one that another host took.
       Not part of the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KeyProbe</RootNamespace>
  </PropertyGroup>

</Project>
