<Project Sdk="WixToolset.Sdk/7.0.1">

  <!-- The MSI installer. Build it after publishing the app to a folder:

         dotnet publish src/MagicSwitcher -c Release -r win-x64 - -self-contained true -p:DebugType=none -o publish\MagicSwitcher
         dotnet build installer -c Release -p:Version=1.5.6 -p:AppDir=C:\full\path\to\publish\MagicSwitcher

       (write the two hyphens of "self-contained" together; XML comments cannot contain them).
       The .msi appears under installer\bin. -->
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <OutputName>MagicSwitcher-$(Version)-win-x64</OutputName>
    <DefineConstants>Version=$(Version);AppDir=$(AppDir)</DefineConstants>
    <!-- WiX 7 binaries are used under the Open Source Maintenance Fee EULA
         (https://github.com/wixtoolset/wix/blob/v7.0.0/OSMFEULA.txt). The fee applies to revenue-generating use with
         an annual gross revenue of US$10,000 or more; this project has none. The project owner accepted the EULA. -->
    <AcceptEula>wix7</AcceptEula>
    <!-- The ICE checks need the Windows Installer service, which build agents do not always have. -->
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>

  <Target Name="CheckAppDir" BeforeTargets="CoreCompile">
    <Error Condition="'$(AppDir)' == '' Or !Exists('$(AppDir)\MagicSwitcher.exe')"
           Text="Pass -p:AppDir=&lt;full path of the published app folder&gt; (it must contain MagicSwitcher.exe)." />
  </Target>

</Project>
